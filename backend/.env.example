APP_HTTP_ADDR=:8090
LOG_LEVEL=info

POSTGRES_DSN=postgres://executor_balancer:executor_balancer@localhost:5442/executor_balancer?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=executor-balancer-v1
KAFKA_ORDER_TOPIC=ais.orders.v1
KAFKA_EXECUTOR_TOPIC=ais.executors.v1
KAFKA_DECISION_RESULT_TOPIC=decision.result.v1
KAFKA_DEAD_LETTER_TOPIC=executor-balancer.dead-letter.v1

AIS_BASE_URL=http://localhost:8091
AIS_REQUEST_TIMEOUT=12s
RESERVATION_TTL=30s

DEPENDENCY_CHECK_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
